  &lt;button id="plot_button" style="margin-top: 15px; padding: 8px 16px; background: #4CAF50; color: white; border: none; border-radius: 4px; cursor: pointer;"&gt;Run Simulation&lt;/button&gt;
&lt;/div&gt;

&lt;!-- Container for the elevation profile --&gt;
